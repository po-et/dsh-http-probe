{
  "name": "dsh-http-probe",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: an http_probe tool for checking status, latency and headers of HTTP endpoints",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "dev": "npx -y @deepseek-ai/dsh web --patch ./dev.cordis.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/po-et/dsh-http-probe.git"
  },
  "homepage": "https://github.com/po-et/dsh-http-probe#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
